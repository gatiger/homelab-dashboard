# Homelab Dashboard runtime settings
APP_NAME=Homelab Dashboard
DASHBOARD_PORT=8080

# Official image. Forks can point this to their own registry namespace.
DASHBOARD_IMAGE=ghcr.io/gatiger/homelab-dashboard
DASHBOARD_VERSION=latest

# Stable named volume used for the SQLite database, secret key, and settings.
DASHBOARD_DATA_VOLUME=homelab-dashboard-data

# Authentication/session settings.
SESSION_HOURS=168
# Set true only when the dashboard itself is accessed through HTTPS.
COOKIE_SECURE=false

# Live health-check tuning.
STATUS_TIMEOUT=4
STATUS_WORKERS=8

# Normally blank. compose.docker.yaml sets this automatically when the
# optional local-Docker insight integration is enabled.
DOCKER_PROXY_URL=

# Optional one-click update manager. TrueNAS App updates use reusable TrueNAS
# Connections configured in the dashboard. Docker Compose updates additionally
# require compose.management.yaml and the restricted update-agent sidecar.
UPDATE_AGENT_IMAGE=ghcr.io/gatiger/homelab-dashboard-agent
UPDATE_AGENT_URL=
UPDATE_AGENT_TOKEN=
UPDATE_AGENT_STACKS_ROOT=
UPDATE_AGENT_COMMAND_TIMEOUT=900
UPDATE_AGENT_HEALTH_TIMEOUT=120
UPDATE_JOB_TIMEOUT=900
# Automatic update discovery interval. Set 0 to disable; manual checks remain available.
UPDATE_CHECK_INTERVAL_HOURS=12

# Extension Registry (data-only packages in v0.17).
EXTENSION_REGISTRY_URL=https://raw.githubusercontent.com/gatiger/homelab-dashboard/main/registry/index.json
EXTENSION_REGISTRY_TIMEOUT=8
EXTENSION_REGISTRY_CACHE_SECONDS=300
